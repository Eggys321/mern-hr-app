# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB connection string
DB_URI=

# Secret used to sign/verify JWTs (note: the code reads JWT_SECRETE, not JWT_SECRET)
JWT_SECRETE=

# Nodemailer / transactional email
EMAIL_SERVICE=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# Front-end URLs used to build links inside emails
CLIENT_URL=
CLIENT_URL_RESET=

# Cloudinary (profile photo uploads)
CLOUD_NAME=
API_KEY=
# note: the code reads API_SECRETE, not API_SECRET
API_SECRETE=

# Optional - defaults to 4040 if unset
PORT=4040
